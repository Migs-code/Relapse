import tkinter as tk
import ast
import operator
import os

try:
    import pygame
    pygame.mixer.init()
    HAS_MUSIC = True
except Exception:
    HAS_MUSIC = False


# ================= SETTINGS =================

BG = "#8B0000"
DISPLAY_BG = "#350000"
BTN = "#C62828"
BTN_OP = "#E53935"
BTN_HOVER = "#FF5252"

CREDIT = "RED CALCULATOR | MADE WITH PYTHON"

SECRET_CODE = "143"
SONG_FILE = "song.mp3"

LYRICS = [
    "Ako'y alipin mo kahit hindi batid",
    "Aaminin ko, minsan ako'y manhid",
    "Sana at iyong naririnig",
    "Sa 'yong yakap, ako'y nasasabik",
    "Ayoko sa iba",
    "Sa 'yo, ako ay hindi magsasawa",
    "Ano man ang 'yong sabihin",
    "Umasa ka, ito ay diringgin",
    "Madalas man na parang aso at pusa",
    "Giliw, sa piling mo, ako ay masaya",
    "Ako'y alipin mo kahit hindi batid",
]

FINAL_RESULT = "I LOVE YOU"
CHAR_DELAY = 100
LINE_DELAY = 2600


# ================= SAFE CALCULATOR =================

OPERATORS = {
    ast.Add: operator.add,
    ast.Sub: operator.sub,
    ast.Mult: operator.mul,
    ast.Div: operator.truediv,
}


def safe_calculate(expression):
    if not expression or len(expression) > 100:
        raise ValueError("Invalid expression")

    tree = ast.parse(expression, mode="eval")

    def solve(node):
        if isinstance(node, ast.Expression):
            return solve(node.body)

        if isinstance(node, ast.Constant):
            if type(node.value) in (int, float):
                return node.value
            raise ValueError("Invalid number")

        if isinstance(node, ast.BinOp) and type(node.op) in OPERATORS:
            left = solve(node.left)
            right = solve(node.right)
            result = OPERATORS[type(node.op)](left, right)

            if abs(result) > 1e100:
                raise ValueError("Result too large")

            return result

        if isinstance(node, ast.UnaryOp):
            value = solve(node.operand)

            if isinstance(node.op, ast.UAdd):
                return value
            if isinstance(node.op, ast.USub):
                return -value

        raise ValueError("Invalid expression")

    return solve(tree)


# ================= RED CALCULATOR =================

class RedCalculator:
    def __init__(self, root):
        self.root = root
        root.title("Red Calculator")
        root.configure(bg=BG)
        root.resizable(False, False)

        self.expression = ""
        self.singing = False
        self.token = 0

        self.display_var = tk.StringVar(value="0")

        tk.Label(
            root,
            textvariable=self.display_var,
            font=("Consolas", 16, "bold"),
            fg="white",
            bg=DISPLAY_BG,
            anchor="e",
            justify="right",
            wraplength=300,
            width=24,
            height=3,
            padx=10,
        ).grid(
            row=0, column=0, columnspan=4,
            padx=12, pady=12, sticky="nsew"
        )

        rows = [
            ["7", "8", "9", "/"],
            ["4", "5", "6", "*"],
            ["1", "2", "3", "-"],
            ["0", ".", "=", "+"],
        ]

        for r, row in enumerate(rows, start=1):
            for c, key in enumerate(row):
                color = BTN_OP if key in "/*-+" else BTN
                self.make_button(key, r, c, 1, color)

        self.make_button("C", 5, 0, 4, DISPLAY_BG)

        tk.Label(
            root,
            text=CREDIT,
            font=("Arial", 10, "bold italic"),
            fg="#ffd0c0",
            bg=BG,
        ).grid(
            row=6, column=0, columnspan=4,
            sticky="e", padx=14, pady=(4, 10)
        )

        root.bind("<Key>", self.keyboard_input)

    def make_button(self, text, row, col, span, color):
        button = tk.Button(
            self.root,
            text=text,
            font=("Arial", 14, "bold"),
            fg="white",
            bg=color,
            activebackground=BTN_HOVER,
            activeforeground="white",
            relief="flat",
            bd=0,
            width=6 if span == 1 else 28,
            height=2,
            command=lambda: self.on_press(text),
        )

        button.grid(
            row=row, column=col, columnspan=span,
            padx=3, pady=3, sticky="nsew"
        )

        button.bind(
            "<Enter>", lambda event: button.config(bg=BTN_HOVER)
        )
        button.bind(
            "<Leave>", lambda event: button.config(bg=color)
        )

    def on_press(self, key):
        if key == "C":
            self.clear()
            return

        if self.singing:
            return

        if key == "=":
            self.calculate()
        elif len(self.expression) < 100:
            self.expression += key
            self.display_var.set(self.expression)

    def keyboard_input(self, event):
        if self.singing:
            return

        if event.char in "0123456789.+-*/":
            self.on_press(event.char)
        elif event.keysym in ("Return", "KP_Enter"):
            self.calculate()
        elif event.keysym == "BackSpace":
            self.expression = self.expression[:-1]
            self.display_var.set(self.expression or "0")
        elif event.keysym == "Escape":
            self.clear()

    def clear(self):
        self.token += 1
        self.singing = False
        self.expression = ""
        self.display_var.set("0")

        if HAS_MUSIC:
            try:
                pygame.mixer.music.stop()
            except Exception:
                pass

    def calculate(self):
        if self.expression.strip() == SECRET_CODE:
            self.start_lyrics()
            return

        try:
            result = safe_calculate(self.expression)

            if isinstance(result, float):
                result = f"{result:.10f}".rstrip("0").rstrip(".")

            self.expression = str(result)
            self.display_var.set(self.expression)

        except (
            ValueError,
            SyntaxError,
            ZeroDivisionError,
            OverflowError,
        ):
            self.expression = ""
            self.display_var.set("Error")

    def start_lyrics(self):
        self.singing = True
        self.token += 1
        current_token = self.token

        if HAS_MUSIC:
            path = os.path.join(
                os.path.dirname(os.path.abspath(__file__)),
                SONG_FILE,
            )

            if os.path.exists(path):
                try:
                    pygame.mixer.music.load(path)
                    pygame.mixer.music.play()
                except Exception:
                    pass

        self.type_step(current_token, 0, 0)

    def type_step(self, token, line_i, char_i):
        if token != self.token:
            return

        if line_i >= len(LYRICS):
            self.singing = False
            self.expression = FINAL_RESULT
            self.display_var.set(FINAL_RESULT)
            return

        line = LYRICS[line_i]

        if char_i <= len(line):
            self.display_var.set(line[:char_i])
            self.root.after(
                CHAR_DELAY,
                self.type_step,
                token,
                line_i,
                char_i + 1,
            )
        else:
            self.root.after(
                LINE_DELAY,
                self.type_step,
                token,
                line_i + 1,
                0,
            )


if __name__ == "__main__":
    root = tk.Tk()
    app = RedCalculator(root)
    root.mainloop()
